// CAP-D01.01 Reservation Management + CAP-D02.03 Availability Management —
// persistence schema.
//
// PostgreSQL (see .env). CAP-D02.03's concurrency guarantees (a shared
// transaction across capacity + reservation + idempotency writes, plus
// pg_advisory_xact_lock) are PostgreSQL-specific — this schema is no
// longer portable to SQLite the way the CAP-D01.01-only version was.
// DateTime columns are explicitly mapped to `timestamptz` (not Prisma's
// PostgreSQL default of `timestamp` without a time zone) so every stored
// instant is unambiguous UTC — see domain/availability/ServiceTime.ts for
// how a stored instant is converted to an Europe/Amsterdam local
// date/time for display or policy decisions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Current authoritative reservation state. CAP-D01.01-R01/R02: id is the
// stable, immutable internal Reservation Identity.
model Reservation {
  id                 String   @id
  servicePeriodId    String
  // CAP-D05.01 — Reservation Contact Management. For a reservation
  // created under this capability, this references a real Contact.id.
  // Historical rows created before CAP-D05.01 existed may hold a legacy,
  // unvalidated value (e.g. a raw phone number) — see
  // R1_3_I1_CAP_D05_01_IMPLEMENTATION_REPORT.md §10 "Legacy contactId
  // Compatibility". Deliberately NOT a foreign key: enforcing one would
  // require backfilling or rejecting every pre-existing row, which this
  // slice explicitly does not attempt.
  contactId          String
  // CAP-D01.01-R07 / CAP-D05.01 — reservation-time NAME snapshot. Already
  // had snapshot semantics before CAP-D05.01 (never re-validated against
  // the Contact on modify); evolved in place rather than duplicated.
  contactName        String?
  // CAP-D05.01 — reservation-time PHONE/EMAIL snapshots, captured from the
  // Contact at booking time. Updating the Contact later must not rewrite
  // these — see domain-model.md's existing "Reservation Contact" concept
  // and rule-model.md CAP-D05.01-R04.
  contactPhoneSnapshot String?
  contactEmailSnapshot String?
  status             String
  reservationDate    DateTime @db.Timestamptz
  partySize          Int
  sourceCategory     String
  externalReference  String?
  importedBy         String?
  // CAP-D01.01-R48: a guest preference (Sushi / Teppanyaki), never a
  // seating guarantee — Warning severity, so it stays nullable.
  preferredArea      String?
  // CAP-D01.01-R36/R37: operational context (allergies, special requests).
  // Not the authoritative allergy record — see the rule comments.
  notes              String?
  // CAP-D01.01-R48: manual, staff-entered table note (e.g. "C1"). Not an
  // owned Seating Assignment guarantee — see the rule comments.
  tableAssignment    String?
  // Operational arrival marker, staff-toggled during service. Outside the
  // scope of this capability's formal rule model (no Rxx) — like
  // tableAssignment, it's a pragmatic staff-facing field, not a modeled
  // check-in/Seating Management capability.
  arrivedAt          DateTime? @db.Timestamptz
  createdBy          String
  createdAt          DateTime @db.Timestamptz
  updatedAt          DateTime @updatedAt @db.Timestamptz
  // Optimistic-concurrency token. Incremented on every write; save()
  // rejects a write whose expected version no longer matches this column.
  version            Int      @default(1)

  events             ReservationEvent[]

  @@map("reservations")
}

// Append-only event history. CAP-D01.01-R04 (history preserved) and
// EV-02 (events are immutable): rows are only ever inserted, never
// updated or deleted by application code.
model ReservationEvent {
  id            String   @id @default(cuid())
  reservationId String
  type          String
  occurredAt    DateTime @db.Timestamptz
  payload       String

  reservation   Reservation @relation(fields: [reservationId], references: [id])

  @@map("reservation_events")
  @@index([reservationId])
}

// CAP-D01.01-R44 — Duplicate Command Processing Must Be Safe. A command
// is applied at most once; save() checks this table before writing.
// reservationId is recorded so a repeated *creation* command can return
// the reservation that was actually persisted the first time, instead
// of silently discarding a freshly (and pointlessly) generated identity.
model AppliedCommand {
  commandId     String   @id
  reservationId String
  appliedAt     DateTime @default(now()) @db.Timestamptz

  @@map("applied_commands")
}

// CAP-D01.01-R51 — a stopgap operational calendar until Availability
// Management exists as its own capability (see R47/R51 in rule-model.md).
// One row per closed date range (inclusive); a single closed day is a
// range where fromDate equals toDate.
model ClosingDay {
  id        String   @id @default(cuid())
  fromDate  DateTime @db.Timestamptz
  toDate    DateTime @db.Timestamptz
  reason    String?
  createdBy String
  createdAt DateTime @default(now()) @db.Timestamptz

  @@map("closing_days")
}

// CAP-D02.03 — Availability Management. One row per capacity commitment
// against a CapacityPool (Sushi / Teppanyaki — see
// domain/availability/CapacityPool.ts; pools are static configuration,
// not a database table, per that file's header comment). Committed rows
// are the input to AvailabilityEvaluator.evaluateSimultaneousOccupancy;
// Released/Superseded rows are kept (never deleted) as history, matching
// the append-only posture already used for ReservationEvent.
//
// reservationId is nullable to allow a future non-reservation consumer of
// capacity (e.g. a walk-in hold) without a schema change, but every
// commitment created by this implementation always sets it.
//
// Database-level invariants enforced via hand-written constraint
// migrations (Prisma has no declarative syntax for either of these as of
// this client version):
//   - party_size > 0, start_time < end_time — CHECK constraints, see
//     prisma/migrations/*_add_capacity_commitment/migration.sql
//   - at most one Committed commitment per reservationId — a partial
//     UNIQUE index, see
//     prisma/migrations/*_one_committed_commitment_per_reservation/migration.sql
//     (R1.1 P0 fix, Concurrent Modify vs Modify — defense in depth
//     alongside the reservation-scoped advisory lock in
//     AvailabilityOrchestrator, not a substitute for it)
// These exist so a defect upstream of this table (a bug in
// AvailabilityOrchestrator, a bypassing script, a future caller) cannot
// silently persist a physically nonsensical or duplicated commitment —
// CAP-D02.03 §22.
model CapacityCommitment {
  commitmentId   String   @id @default(cuid()) @map("commitment_id")
  reservationId  String?  @map("reservation_id")
  capacityPoolId String   @map("capacity_pool_id")
  startTime      DateTime @map("start_time") @db.Timestamptz
  endTime        DateTime @map("end_time") @db.Timestamptz
  partySize      Int      @map("party_size")
  // Committed | Released | Superseded — see domain/availability/CapacityCommitment.ts.
  status         String
  // Not a unique constraint here: idempotency for the write that produced
  // this row is enforced once, authoritatively, by AppliedCommand.commandId
  // (@id) inside the SAME shared transaction — see
  // application/availability/AvailabilityOrchestrator.ts. A second unique
  // constraint on this column would duplicate that guarantee, not
  // strengthen it. Indexed purely to support findByCommandId lookups.
  commandId      String   @map("command_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("capacity_commitments")
  @@index([capacityPoolId, startTime, endTime])
  @@index([reservationId])
  @@index([commandId])
}

// CAP-D05.01 — Reservation Contact Management (R1.3-I1). Replaces the
// UnvalidatedContactReader placeholder: a Reservation now references a
// real, validated Contact record instead of an arbitrary string (in the
// pilot, previously the guest's raw typed phone number).
//
// Deliberately minimal — this is NOT a guest CRM (CAP-D05.03 Guest
// Preference Management and CAP-D05.04 Guest Profile Reference remain
// Deferred). No VIP/spend/visit-history columns; no merge machinery.
//
// id is an internal HELIX-generated identity (CAP-D05.01-R02) — never
// derived from phone/email/name, and never a Guestplan or other external
// identifier (see the R1.3 architecture investigation §23 on the
// CAP-D05.04 / CAP-D07.03 registry overlap — external references are
// deliberately out of scope here).
//
// phone/email are both optional at the column level; CAP-D05.01-R01
// (name + at least one of phone/email) is enforced in
// domain/rules/ContactRules.ts, not by a database CHECK constraint —
// consistent with how this codebase enforces cross-field rules elsewhere
// (see CapacityCommitment's comment on why some invariants ARE
// hand-written CHECK constraints: this one does not need that treatment
// because it is not defending against a bypass of the aggregate/handler
// layer the way concurrency-critical capacity invariants are).
//
// No uniqueness constraint on phoneNormalized/emailNormalized — see
// rule-model.md CAP-D05.01-R03: a shared phone/email is a POSSIBLE
// MATCH signal for staff, never proof of identity, so this schema must
// not silently treat two guests sharing a phone as an error.
model Contact {
  id                   String    @id @default(cuid())
  displayName          String    @map("display_name")
  phoneRaw             String?   @map("phone_raw")
  // Bounded NL/international normalizer — see
  // domain/value-objects/PhoneNumber.ts. Not a maintained third-party
  // parsing library: no evidence in this repository of a guest base
  // broad enough to justify one yet (R1.3 architecture investigation §13).
  phoneNormalized      String?   @map("phone_normalized")
  emailRaw             String?   @map("email_raw")
  emailNormalized      String?   @map("email_normalized")
  // Active | Anonymized — see domain/value-objects/ContactStatus.ts.
  // Anonymized, never deleted: a Reservation may still reference this id
  // (CAP-D05.01-R? / INV-G06 in the architecture investigation) and must
  // not be left with a dangling reference.
  status               String    @default("Active")
  createdBy            String    @map("created_by")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  // Retention anchor for the owner-confirmed 5-year PII policy (R1.3-I1
  // assignment §"Retention anchor"). Updated when this Contact
  // participates in a new reservation or is explicitly edited.
  // AUTOMATED retention execution is explicitly deferred for this slice —
  // see R1_3_I1_CAP_D05_01_IMPLEMENTATION_REPORT.md. This column exists
  // so a later, separate piece of work has enough information to
  // determine retention eligibility without redesigning this table.
  lastRelevantActivityAt DateTime @map("last_relevant_activity_at") @db.Timestamptz

  @@map("contacts")
  @@index([phoneNormalized])
  @@index([emailNormalized])
}

// R1.2 — Identity & Access. Real staff identity, replacing the
// self-reported x-actor-* HTTP headers as a source of production
// authority — see R1_2_IDENTITY_ACCESS_FINAL_ARCHITECTURE.md and
// R1_2_IDENTITY_ACCESS_IMPLEMENTATION_REPORT.md.
//
// id is the stable identity anchor (§6 of the architecture doc) —
// audit attribution is anchored to it, never to username/email/
// displayName, all three of which may change over a person's employment.
//
// role reuses ActorRole (domain/value-objects/Actor.ts) rather than a
// second, parallel enum — StaffUser.role and Actor.role are the same
// domain concept; the server derives one from the other at request time
// (see api/authMiddleware.ts), it does not maintain two.
//
// Database-level invariant: at most one StaffUser may hold role='Owner'
// at a time — a hand-written partial UNIQUE index (Prisma has no
// declarative syntax for this, same situation as CapacityCommitment's
// invariants above), see
// prisma/migrations/*_one_owner_staff_user/migration.sql. This is both
// the Owner-protection mechanism (domain/rules/StaffAuthorizationPolicy.ts)
// and the bootstrap/recovery gate (infrastructure/bootstrap/bootstrapOwner.ts):
// bootstrap can run exactly once because a second attempt collides with
// this same constraint, with no separate "has bootstrap run" flag needed.
model StaffUser {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  // Optional, unique when present (never mandatory, never the sole
  // identifier — some staff have no individual email address). Prisma's
  // @unique on a nullable column allows any number of NULLs (standard
  // Postgres UNIQUE semantics — two NULLs are never "equal"), so this
  // needs no partial-index workaround the way the Owner invariant does.
  email        String?  @unique
  passwordHash String   @map("password_hash")
  role         String
  status       String   @default("Active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sessions     StaffSession[]

  @@map("staff_users")
}

// Server-side session — the opaque cookie value the client holds maps to
// exactly one row here, looked up by the SHA-256 hash of that value
// (domain/shared/hashSessionToken.ts). The raw token itself is never
// persisted anywhere; only its hash, so a database read alone can never
// yield a usable session token.
//
// Deliberately carries no role or status — every authenticated request
// re-reads StaffUser.role/.status live via the staffUserId relation, so a
// disable or role change takes effect on the very next request (see
// R1_2_IDENTITY_ACCESS_FINAL_ARCHITECTURE.md §9). Storing a copy here
// would reintroduce exactly the stale-authority problem that design
// choice exists to avoid.
model StaffSession {
  // The SHA-256 hash of the opaque token (hex), not a separately
  // generated row id — the hash itself is already a stable, unique,
  // lookup-ready value; a second id column would be redundant.
  id          String    @id
  staffUserId String    @map("staff_user_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz

  staffUser   StaffUser @relation(fields: [staffUserId], references: [id])

  @@map("staff_sessions")
  @@index([staffUserId])
}

// R1.2 §26 — a separate log from ReservationDomainEvent: account-lifecycle
// events are not reservation-domain events, and conflating them would
// violate the existing event model's own stated ownership boundary
// ("owned by Reservation Management even when consumed elsewhere" —
// domain/events/ReservationEvents.ts). Minimal by design — no IP/device
// metadata column: evaluated in the architecture doc and deliberately
// left out unless a real operational need justifies collecting it
// ("do not over-collect").
model SecurityEvent {
  id                 String   @id @default(cuid())
  type               String
  occurredAt         DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  actingStaffUserId  String?  @map("acting_staff_user_id")
  targetStaffUserId  String?  @map("target_staff_user_id")
  metadata           String?

  @@map("security_events")
  @@index([targetStaffUserId])
}

// R1.2 final P1 closure — login abuse protection
// (R1_2_LOGIN_ABUSE_PROTECTION_REPORT.md). One row per throttle key —
// "source:<address>" or "username:<normalized>" — a fixed window that
// resets (rather than a rolling window) the moment a request arrives
// after `windowStart` is more than the configured window old. `key` is
// deliberately opaque to the schema: which dimension it represents lives
// in application/auth/LoginThrottleGuard.ts, not here.
//
// PostgreSQL-backed, not in-memory: this app may run as more than one
// process/instance, and an in-memory counter would silently stop being
// effective the moment it did (each instance would enforce its own,
// smaller-than-intended limit against a share of the traffic, not the
// true global count) — see the report's Storage Model section.
model LoginAttemptWindow {
  key         String   @id
  windowStart DateTime @map("window_start") @db.Timestamptz
  count       Int
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("login_attempt_windows")
}

// CAP-D03.03 — Table and Seat Management (R1.5). One physical, claimable
// floor resource. Deliberately ONE entity type for both Sushi tables/bar
// positions AND Teppanyaki grills — R1_5_FLOOR_SEATING_FINAL_ARCHITECTURE.md
// §4: "one entity type, two usage patterns, driven entirely by the
// supportsSharedSeating flag." `areaId` reuses CapacityPoolId's exact
// string values ("Sushi" | "Teppanyaki", domain/availability/CapacityPool.ts)
// — deliberately NOT a new Area/CapacityPool table; see that file's own
// "promote only when a concrete need exists" precedent (product-principles.md
// PRP-014/PRP-020).
//
// A Sushi table (supportsSharedSeating: false) is claimed as a whole unit
// via SeatingAssignmentResource.tableId — no Seat children exist for it.
// A Teppanyaki grill (supportsSharedSeating: true) is claimed seat-by-seat
// via its Seat children (below); the Table row itself is never directly
// claimed by a SeatingAssignmentResource for a shared-seating table.
//
// id is a stable, immutable internal identity, never reused — see §20 of
// the final architecture (historical correctness): renaming or
// deactivating a Table must never corrupt a historical SeatingAssignment's
// interpretability. operationalLabel ("Table 1", "Bar 17", "C") is the
// staff-facing name and MAY change; id never does.
model Table {
  id                    String   @id @default(cuid())
  areaId                String   @map("area_id")
  operationalLabel      String   @map("operational_label")
  nominalCapacity       Int      @map("nominal_capacity")
  supportsSharedSeating Boolean  @default(false) @map("supports_shared_seating")
  // Active | Inactive — a genuinely retired/not-yet-in-service resource.
  // Distinct from a time-bounded ResourceBlock (below) — see final
  // architecture §9.
  status                String   @default("Active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  seats        Seat[]
  resourceBlocks ResourceBlock[]

  @@map("tables")
  @@index([areaId])
}

// One individually-claimable seat at a supportsSharedSeating Table
// (today: the four Teppanyaki grills only). id is the stable identity a
// SeatingAssignmentResource references; operationalLabel ("C-01") is the
// staff-facing name.
model Seat {
  id               String   @id @default(cuid())
  tableId          String   @map("table_id")
  operationalLabel String   @map("operational_label")
  status           String   @default("Active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  table Table @relation(fields: [tableId], references: [id])

  @@map("seats")
  @@index([tableId])
}

// CAP-D02.03-owned concept (capability-registry.yaml.md already registers
// "Resource Block" under Availability Management, not under Table/Seat
// Management — R1_5 final architecture §9 confirms this as the correct,
// pre-existing owner). A time-bounded, reasoned, attributed exclusion —
// distinct from Table.status: physical existence (Table.status) and
// operational availability (ResourceBlock) are separate concepts (owner's
// own framing, chef-shortage example). Always Table-scoped (a whole
// grill/table goes offline, e.g. for a chef shortage) — never Seat-scoped,
// per the owner's own example and the final architecture §9's explicit
// finding that nothing evidences a need to block individual seats
// independently of their table; blocking the parent Table's id is read as
// "every seat under this Table is unavailable for the blocked interval"
// (enforced in application logic, not a second FK) — this is the "one
// parent-level block... not ten duplicate blocks" requirement (assignment
// §17) satisfied structurally by scoping the block to the Table, not by
// generating one row per Seat.
model ResourceBlock {
  id        String   @id @default(cuid())
  tableId   String   @map("table_id")
  startTime DateTime @map("start_time") @db.Timestamptz
  endTime   DateTime @map("end_time") @db.Timestamptz
  reason    String?
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  table Table @relation(fields: [tableId], references: [id])

  @@map("resource_blocks")
  @@index([tableId, startTime, endTime])
}

// CAP-D04.01 — Seating Assignment (R1.5). One SeatingAssignment belongs to
// exactly one Reservation; a Reservation has at most one non-Released
// SeatingAssignment at a time (mirrors CapacityCommitment's own "one
// Committed per reservation" invariant — final architecture §10).
//
// status: Assigned | Seated | Released — the single collapsed operational
// status the owner confirmed (final architecture §14) — no separate
// Arrived state. seatedAt is set only on the Assigned -> Seated
// transition. releaseReason (e.g. "NoShow", "StaffReassigned",
// "GuestCancelled", "Completed") is set only on release.
//
// startTime/endTime are the reservation's own occupied interval, carried
// here (not re-derived via a live join every read) for the same reason
// CapacityCommitment already stores its own — see SeatingAssignmentResource
// below, where the SAME interval is what the PostgreSQL EXCLUDE
// constraints actually operate on.
model SeatingAssignment {
  id            String    @id @default(cuid())
  reservationId String    @map("reservation_id")
  status        String
  releaseReason String?   @map("release_reason")
  startTime     DateTime  @map("start_time") @db.Timestamptz
  endTime       DateTime  @map("end_time") @db.Timestamptz
  assignedBy    String    @map("assigned_by")
  assignedAt    DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  seatedAt      DateTime? @map("seated_at") @db.Timestamptz
  releasedBy    String?   @map("released_by")
  releasedAt    DateTime? @map("released_at") @db.Timestamptz
  // Idempotency — mirrors AppliedCommand's role for CAP-D01.01/CapacityCommitment.
  commandId     String    @map("command_id")

  resources SeatingAssignmentResource[]

  @@map("seating_assignments")
  @@index([reservationId])
  @@index([commandId])
}

// One row per physical Table or Seat claimed by a SeatingAssignment —
// final architecture §7/§10: the SAME mechanism represents a single Sushi
// table, multiple combined Sushi tables, individual Sushi bar positions,
// one or many Teppanyaki seats, and seats spanning multiple grills.
// Exactly one of tableId/seatId is set per row (enforced by a hand-written
// CHECK constraint — see the migration; Prisma has no declarative XOR
// syntax, same situation as every other hand-written constraint in this
// schema).
//
// status/startTime/endTime DUPLICATE the parent SeatingAssignment's own
// fields, updated together with it in the same transaction — this is not
// redundant modeling, it is a structural requirement: a PostgreSQL EXCLUDE
// constraint (see migration 20260820..._add_seating_resource_exclusion_constraints)
// operates on THIS row directly and cannot join to a parent table, so the
// interval and status it must reason about have to live here.
model SeatingAssignmentResource {
  id           String   @id @default(cuid())
  assignmentId String   @map("assignment_id")
  tableId      String?  @map("table_id")
  seatId       String?  @map("seat_id")
  status       String
  startTime    DateTime @map("start_time") @db.Timestamptz
  endTime      DateTime @map("end_time") @db.Timestamptz

  assignment SeatingAssignment @relation(fields: [assignmentId], references: [id])

  @@map("seating_assignment_resources")
  @@index([assignmentId])
  @@index([tableId])
  @@index([seatId])
}

// "Service Period" booking-window eligibility (R1.6-A, Chief Engineer
// assignment). Date-specific EXCEPTION to the static weekly schedule in
// domain/availability/ServicePeriod.ts — the weekly schedule itself is
// static config (same "small, static, promote only when needed"
// precedent as CapacityPool.ts), so only this override layer needs real
// persistence.
//
// IMPORTANT — registry divergence, not silently resolved: this does NOT
// implement the capability registry's actual CAP-D02.02 definition (a
// live per-date service-session lifecycle — ServicePeriodCreated /
// -Opened / -Closed, active floorplan selection; capability-registry.yaml.md
// lines 372-415). That concept is unrelated and remains entirely unbuilt.
// This instead answers a narrower, currently-unregistered question closer
// to CAP-D02.01 Service Management's own "default operating times" rule
// (registry lines 335-370). See
// R1_6_A_SERVICE_PERIOD_IMPLEMENTATION_REPORT.md §2 for the full analysis.
//
// areaId reuses CapacityPoolId's exact string values ("Sushi" |
// "Teppanyaki"), same precedent as Table.areaId — deliberately not a new
// Area table. Always area-scoped (never a nullable "applies to all areas"
// row) — the simplest correct representation (assignment §8): a single
// `WHERE areaId = X AND date = Y` lookup, no fallback branching. `date` is
// a plain calendar date, no time-of-day/timezone component — same
// convention as ClosingDay.fromDate/toDate (see PrismaClosingDayStore.ts's
// startOfDay comment on why a bare calendar date needs no local-time
// conversion).
model ServicePeriodOverride {
  id        String   @id @default(cuid())
  areaId    String   @map("area_id")
  date      DateTime @db.Date
  status    String   // "Open" | "Closed"
  reason    String?
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  windows ServicePeriodOverrideWindow[]

  @@map("service_period_overrides")
  @@unique([areaId, date])
}

// One booking window (first/last valid START minute-of-day, local) for an
// Open ServicePeriodOverride — absent entirely when the parent's status
// is "Closed". firstStartMinute/lastStartMinute mirror
// domain/availability/ServicePeriod.ts's BookingWindow shape exactly —
// this table is that pure domain type's persisted form, nothing more.
model ServicePeriodOverrideWindow {
  id               String @id @default(cuid())
  overrideId       String @map("override_id")
  firstStartMinute Int    @map("first_start_minute")
  lastStartMinute  Int    @map("last_start_minute")

  override ServicePeriodOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)

  @@map("service_period_override_windows")
  @@index([overrideId])
}
