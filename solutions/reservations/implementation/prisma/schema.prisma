// CAP-D01.01 Reservation Management — persistence schema.
//
// Local verification uses SQLite (see .env) so this can run without any
// external service. Production target is PostgreSQL, per the technology
// choice for this solution — switch `provider` below and DATABASE_URL to
// move; no application code depends on which one is active.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Current authoritative reservation state. CAP-D01.01-R01/R02: id is the
// stable, immutable internal Reservation Identity.
model Reservation {
  id                 String   @id
  servicePeriodId    String
  contactId          String
  // CAP-D01.01-R07: "Additional guest or contact information may exist"
  // alongside the primary contact identity (contactId).
  contactName        String?
  status             String
  reservationDate    DateTime
  partySize          Int
  sourceCategory     String
  externalReference  String?
  importedBy         String?
  // CAP-D01.01-R48: a guest preference (Sushi / Teppanyaki), never a
  // seating guarantee — Warning severity, so it stays nullable.
  preferredArea      String?
  // CAP-D01.01-R36/R37: operational context (allergies, special requests).
  // Not the authoritative allergy record — see the rule comments.
  notes              String?
  // CAP-D01.01-R48: manual, staff-entered table note (e.g. "C1"). Not an
  // owned Seating Assignment guarantee — see the rule comments.
  tableAssignment    String?
  // Operational arrival marker, staff-toggled during service. Outside the
  // scope of this capability's formal rule model (no Rxx) — like
  // tableAssignment, it's a pragmatic staff-facing field, not a modeled
  // check-in/Seating Management capability.
  arrivedAt          DateTime?
  createdBy          String
  createdAt          DateTime
  updatedAt          DateTime @updatedAt
  // Optimistic-concurrency token. Incremented on every write; save()
  // rejects a write whose expected version no longer matches this column.
  version            Int      @default(1)

  events             ReservationEvent[]

  @@map("reservations")
}

// Append-only event history. CAP-D01.01-R04 (history preserved) and
// EV-02 (events are immutable): rows are only ever inserted, never
// updated or deleted by application code.
model ReservationEvent {
  id            String   @id @default(cuid())
  reservationId String
  type          String
  occurredAt    DateTime
  payload       String

  reservation   Reservation @relation(fields: [reservationId], references: [id])

  @@map("reservation_events")
  @@index([reservationId])
}

// CAP-D01.01-R44 — Duplicate Command Processing Must Be Safe. A command
// is applied at most once; save() checks this table before writing.
// reservationId is recorded so a repeated *creation* command can return
// the reservation that was actually persisted the first time, instead
// of silently discarding a freshly (and pointlessly) generated identity.
model AppliedCommand {
  commandId     String   @id
  reservationId String
  appliedAt     DateTime @default(now())

  @@map("applied_commands")
}

// CAP-D01.01-R51 — a stopgap operational calendar until Availability
// Management exists as its own capability (see R47/R51 in rule-model.md).
// One row per closed date range (inclusive); a single closed day is a
// range where fromDate equals toDate.
model ClosingDay {
  id        String   @id @default(cuid())
  fromDate  DateTime
  toDate    DateTime
  reason    String?
  createdBy String
  createdAt DateTime @default(now())

  @@map("closing_days")
}
