DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"

# P1-B11A — optional. The host api/server.ts's app.listen binds to.
# Defaults to the IPv4 loopback address (127.0.0.1) when unset, blank, or
# whitespace-only — never all-interfaces by default. Set to "0.0.0.0" (or
# a specific interface address) only for a future real deployment
# environment that genuinely needs to accept connections from other hosts.
# APP_HOST="127.0.0.1"

# R1.4 P0 — required for the integration/API test suite. MUST be a
# structurally distinct database from DATABASE_URL above (a different
# name, never the same database via a second variable) — see
# tests/integration/support/testDatabaseSafety.ts and
# ops/testDatabaseSetup.ts. Tests refuse to run destructive resets
# without this set to a database that has been explicitly provisioned
# as a test database.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_test?schema=public"

# P1-B4-D1 — required only by `npm run seed-floor` (ops/floor/seedFloor.ts).
# Deliberately separate from DATABASE_URL — this operation never falls
# back to it. Must point at the approved development database
# (helix_reservations_dev); the actual connected database is
# independently re-verified via a live query before any write, so a
# merely-correct-looking URL is not sufficient on its own — see
# SEED_FLOOR_CONFIRM_DATABASE below and ops/floor/seedFloorSafety.ts.
# SEED_FLOOR_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/helix_reservations_dev?schema=public"

# P1-B4-D1 — required alongside SEED_FLOOR_DATABASE_URL above: explicit
# operator confirmation, separate from the URL itself. Must be set to
# exactly the approved database name below (not an interactive prompt —
# a plain env var).
# SEED_FLOOR_CONFIRM_DATABASE="helix_reservations_dev"

# R1.4 — optional. Directory containing pg_dump/pg_restore/psql if they
# are not already on PATH (see ops/shared/pgTools.ts).
# PG_BIN_DIR="C:\Program Files\PostgreSQL\17\bin"

# R1.4 — optional. Where ops/backup/createBackup.ts writes backup
# artifacts. Defaults to ./backups (gitignored) if unset. In a future
# production deployment this should point at an independent failure
# domain (§9/§10 of the architecture report) — never the same host/disk
# as the primary database.
# BACKUP_DESTINATION_DIR="./backups"

# R1.4 — required only by ops/restore/restoreBackup.ts. The target
# database to restore INTO. Deliberately separate from DATABASE_URL/
# TEST_DATABASE_URL so a restore can never be pointed at either by
# accident — restoreBackup.ts additionally refuses to run against a
# non-empty/operational-looking target unless RESTORE_DISASTER_RECOVERY_CONFIRM
# is also explicitly set (see ops/restore/restoreBackup.ts).
# RESTORE_TARGET_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_recovery?schema=public"

# R1.4 — optional, only needed if RESTORE_TARGET_DATABASE_URL's own role
# is not a PostgreSQL superuser. Disabling FK constraint triggers for a
# reliable data-only restore (ops/restore/restoreBackup.ts) requires
# superuser privilege regardless of table ownership. Same host/port/
# database as RESTORE_TARGET_DATABASE_URL, an elevated role.
# RESTORE_SUPERUSER_DATABASE_URL="postgresql://SUPERUSER:PASSWORD@localhost:5432/DATABASE_recovery?schema=public"

# R1.6-B/R1.6-C1B — read only by ops/communications/processOutbox.ts
# (buildEmailPort), which is run via `npm run process-communications`.
# Not read by api/server.ts — the API only enqueues guest communication
# emails (CommunicationOutboxService), it never sends them itself.
#
# Unset, or set to "fake": the deterministic FakeEmailDeliveryPort is
# used — no external call is ever made. This is the default, and is
# what every existing deployment/test relies on today.
#
# Set to "resend": the real ResendEmailDeliveryAdapter is used, and
# EMAIL_PROVIDER_API_KEY + EMAIL_FROM_ADDRESS below become required —
# buildEmailPort throws rather than silently falling back to "fake" if
# either is missing (fail-closed by design, see processOutbox.ts).
# EMAIL_PROVIDER="fake"

# R1.6-C1B — the Resend API key ("Konnichiwa Reservation App", send-only,
# scoped to the konnichiwa.nl domain). Only read when EMAIL_PROVIDER=resend.
# NEVER commit a real value here — this file is checked in. Set the real
# key only in a local, gitignored .env.
# EMAIL_PROVIDER_API_KEY=""

# R1.6-C1B — owner-confirmed sender, e.g. "Konnichiwa <reservations@konnichiwa.nl>"
# (see infrastructure/communications/ResendEmailDeliveryAdapter.ts). Only
# read when EMAIL_PROVIDER=resend. Note: reservations@konnichiwa.nl is the
# approved address, but the mailbox/domain verification for it has not
# been created yet as of this writing — that is an operational
# prerequisite (Resend domain setup, DNS), not something this code can
# do; real sends will fail (safely, as FAILED_PERMANENT) until it exists.
# EMAIL_FROM_ADDRESS=""

# R1.6-C1B — optional reply-to, e.g. "info@konnichiwa.nl" (an existing,
# already-working mailbox). Omitted entirely from the Resend request
# when unset, never sent as an empty string.
# EMAIL_REPLY_TO=""
