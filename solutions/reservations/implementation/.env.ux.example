# R1.5-P7-D — isolated Reception UX environment (copy to .env.ux, which is gitignored).
# Same local cluster (port 5433) as development, but the separate UX database.
# ux:provision / ux:seed / ux:teardown refuse to run against any other database name.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/helix_reservations_ux?schema=public"
PORT=3002
APP_HOST="127.0.0.1"
